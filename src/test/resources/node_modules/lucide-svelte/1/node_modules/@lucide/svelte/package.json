{
  "name": "@lucide/svelte",
  "version": "1.38.0",
  "type": "module",
  "main": "dist/lucide-svelte.js",
  "svelte": "dist/lucide-svelte.js",
  "types": "dist/lucide-svelte.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lucide-svelte.d.ts",
      "svelte": "./dist/lucide-svelte.js",
      "default": "./dist/lucide-svelte.js"
    },
    "./icons": {
      "types": "./dist/lucide-svelte.d.ts",
      "svelte": "./dist/lucide-svelte.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.svelte.d.ts",
      "svelte": "./dist/icons/*.js",
      "default": "./dist/icons/*.js"
    }
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
